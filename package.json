{
  "name": "sparkminds-lab",
  "version": "2.5.1",
  "private": false,
  "description": "SparkMinds Lab — 实验室物联网监控平台桌面版",
  "author": "SparkMinds",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "electron .",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:all": "electron-builder --win nsis portable --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.sparkminds.lab",
    "productName": "SparkMinds Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "wrangler.toml"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SparkMindsLab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SparkMinds Lab"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "wrangler": "^3.90.0"
  },
  "dependencies": {}
}
